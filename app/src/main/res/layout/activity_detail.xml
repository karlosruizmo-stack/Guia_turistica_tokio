<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver a la guía"
            android:textColor="@color/purple"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/detailEmoji"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:gravity="center"
            android:text="🏯"
            android:textSize="76sp"
            android:background="@drawable/hero_background" />

        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONUMENTOS"
            android:textColor="@color/purple"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del lugar"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/detailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/mapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver ubicación en el mapa"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/purple" />

        <Button
            android:id="@+id/phoneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llamar / contactar"
            android:backgroundTint="@color/purple" />

        <Button
            android:id="@+id/webButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visitar página web"
            android:backgroundTint="@color/purple" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compartir lugar"
            android:backgroundTint="@color/purple" />
    </LinearLayout>
</ScrollView>
